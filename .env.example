# Kopiere diese Datei zu ".env" und trage deine echten Werte ein.
# Die .env wird NICHT committet (steht in .gitignore).

ANTHROPIC_API_KEY=
TRAINER_MODEL=claude-sonnet-5
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
# Zweiter Bot-Token für den "assistant"-Agenten (Multi-Agent, optional/leer ok)
ASSISTANT_BOT_TOKEN=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
HEALTH_WEBHOOK_SECRET=
# Kommaseparierte Liste geheimer iCal-Links (mehrere Kalender möglich)
CALENDAR_ICS_URLS=
OBSIDIAN_VAULT_PATH=
HEVY_API_KEY=
