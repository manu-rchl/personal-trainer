[Unit]
Description=Trainer Hevy Full Sync + Delete-Abgleich

[Service]
Type=oneshot
WorkingDirectory=/root/manuel/personal-trainer-manuel
ExecStart=/root/.local/bin/uv run python -m trainer.ingest.hevy sync --full
StandardOutput=append:/root/manuel/personal-trainer-manuel/logs/hevy-full-sync.log
StandardError=append:/root/manuel/personal-trainer-manuel/logs/hevy-full-sync.error.log
