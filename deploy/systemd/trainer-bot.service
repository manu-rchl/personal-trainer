[Unit]
Description=Trainer Telegram Bot (isa)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/manuel/personal-trainer-manuel
ExecStart=/root/.local/bin/uv run python -m trainer.bot.main
# Nur bei Crash neu starten (Konfigfehler beenden mit Exit 0 und bleiben liegen);
# 60 s Abstand statt 5 s gegen Restart-Storms.
Restart=on-failure
RestartSec=60
StandardOutput=append:/root/manuel/personal-trainer-manuel/logs/bot.log
StandardError=append:/root/manuel/personal-trainer-manuel/logs/bot.error.log

[Install]
WantedBy=multi-user.target
