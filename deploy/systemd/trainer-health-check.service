[Unit]
Description=Trainer Health Check

[Service]
Type=oneshot
WorkingDirectory=/root/manuel/personal-trainer-manuel
ExecStart=/root/.local/bin/uv run python -m trainer.jobs.health_check
StandardOutput=append:/root/manuel/personal-trainer-manuel/logs/health-check.log
StandardError=append:/root/manuel/personal-trainer-manuel/logs/health-check.error.log
