[Unit]
Description=Trainer Web Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/manuel/personal-trainer-manuel
ExecStart=/root/.local/bin/uv run uvicorn trainer.web.app:app --host 127.0.0.1 --port 8090
# Nur bei Crash neu starten (Konfigfehler beenden mit Exit 0 und bleiben liegen);
# 60 s Abstand statt 5 s gegen Restart-Storms.
Restart=on-failure
RestartSec=60
StandardOutput=append:/root/manuel/personal-trainer-manuel/logs/web.log
StandardError=append:/root/manuel/personal-trainer-manuel/logs/web.error.log

[Install]
WantedBy=multi-user.target
