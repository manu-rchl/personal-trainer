[Unit]
Description=Trainer Weekly Report

[Service]
Type=oneshot
WorkingDirectory=/root/manuel/personal-trainer-manuel
ExecStart=/root/.local/bin/uv run python -m trainer.jobs.weekly_report
StandardOutput=append:/root/manuel/personal-trainer-manuel/logs/weekly-report.log
StandardError=append:/root/manuel/personal-trainer-manuel/logs/weekly-report.error.log
